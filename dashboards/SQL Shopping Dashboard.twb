          <object caption='NumProductsByOrder' id='_04E08806E74D4EDA99E0092C553A81D2'>
            <properties context=''>
              <relation connection='sqlserver.0jtrta01te2lla11nib2j051ijkm' name='Custom SQL Query' type='text'>select o.order_id,&#13;
       count(od.product_id) as num_products&#13;
  from Orders o&#13;
  join OrderDetails od&#13;
    on od.order_id = o.order_id&#13;
 group by o.order_id</relation>
            </properties>
          </object>
          <object caption='OrderTotals' id='_CF14485B14D548B98747B214FA1677D9'>
            <properties context=''>
              <relation connection='sqlserver.0jtrta01te2lla11nib2j051ijkm' name='Custom SQL Query1' type='text'>select o.order_id,&#13;
       sum(od.quantity * od.unit_price_usd) as order_total&#13;
  from Orders o&#13;
  join OrderDetails od&#13;
    on od.order_id = o.order_id&#13;
 group by o.order_id</relation>
            </properties>
          </object>
